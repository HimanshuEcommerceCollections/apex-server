# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Public base URL of THIS API and of the client (used in email links, CORS).
APP_BASE_URL=http://localhost:4000
CLIENT_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apex?schema=public

# ---------------------------------------------------------------------------
# Auth (accounts + staff). Access JWT is short-lived and held in memory by the
# SPA; the refresh token is an httpOnly cookie. Generate random strings; never
# reuse across environments. (docs/architecture/07 §3)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
# AES-256-GCM key (32 bytes, base64 or hex) that encrypts staff TOTP secrets.
MFA_ENC_KEY=change-me-to-a-32-byte-base64-key

# ---------------------------------------------------------------------------
# HTTP
# In production CORS_ORIGIN MUST be explicit origins (comma-separated); a
# wildcard is rejected by browsers together with credentialed requests.
# ---------------------------------------------------------------------------
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Shared secret the backend uses to trigger Next.js ISR revalidation on publish.
REVALIDATE_SECRET=change-me

# ---------------------------------------------------------------------------
# Stripe (shared account with Elevate — every Apex object is tagged
# metadata.brand=APEX; the webhook ignores non-Apex events). Phase 5+.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Email (provider-agnostic EmailService). Phase 2+.
#   EMAIL_PROVIDER=resend  -> set RESEND_API_KEY
#   EMAIL_PROVIDER=smtp    -> set SMTP_* (Gmail SMTP for dev/QA only)
# If the selected provider's credentials are blank the service falls back to the
# console provider and only logs messages (email.service.ts:resolveProviderName).
#
# Gmail SMTP: SMTP_USER is the full Gmail address, SMTP_PASS is a 16-char Google
# App Password (myaccount.google.com/apppasswords, needs 2-Step Verification) —
# the account password is rejected. Port 587 = STARTTLS, 465 = implicit TLS (the
# provider switches on port === 465). Gmail rewrites From to the authenticated
# account, so EMAIL_FROM should use that same address.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM="Apex Total Home Services <your-gmail-address@gmail.com>"
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Stripe (shared account with Elevate; Apex objects are brand-tagged) ---
# The secret/publishable keys may be shared across brands; the webhook secret is
# PER-ENDPOINT — register this API's /webhooks/stripe endpoint to get one, or use
# `stripe listen --forward-to localhost:4000/webhooks/stripe` locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Bearer token Vercel Cron sends to the abandoned-payment sweep endpoint.
CRON_SECRET=
